# The stack's two inputs. Nothing in this repo supplies them: on a droplet
# ~/setup.sh generates a real .env from the host type, and for local work there
# is a ready-made `docker compose --env-file .env.dev`. Copy this to .env to
# point a checkout somewhere else by hand.

# Where certbot, text-edit and mysql keep their data.
DATA_DIR=/path/to/data

# The single name this instance answers on. nginx's server_name, the unsafe. and
# stage. vhosts, the certbot lineage under certbot/conf/live and phpmyadmin's
# absolute URI are all derived from it.
SITE_DOMAIN=example.com
