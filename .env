# Production values. Both docker compose (for interpolation) and, when sourced
# with `set -a; . ./.env; set +a`, your own shell read this file.

DATA_DIR=/mnt/thevenin_data

# The domain this instance answers on. nginx's server_name, the unsafe. and
# stage. vhosts and phpmyadmin's absolute URI are all derived from it, so
# pointing the stack at another domain is a one-line change here.
SITE_DOMAIN=xin-xin.me

# Extra names the main vhost also answers to, space separated. Optional; leave
# empty for a bare domain. These are not derived from SITE_DOMAIN, so they must
# be spelled out in full.
SITE_ALT_NAMES="www.xin-xin.me new.xin-xin.me"

# certbot lineage name, i.e. the directory under certbot/conf/live that holds
# fullchain.pem and privkey.pem. Defaults to SITE_DOMAIN when unset; pinned here
# because this instance's certificate was issued under the older new.xin-xin.me
# name and renaming a lineage means re-issuing it.
SITE_CERT_NAME=new.xin-xin.me
