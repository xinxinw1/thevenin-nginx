server {
    listen 80;
    server_name ${SITE_DOMAIN} stage.${SITE_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 80;
    server_name unsafe.${SITE_DOMAIN};

    location / {
        proxy_pass http://main-website:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # TODO: dead route. 127.0.0.1 here is this nginx container's own loopback,
    # not the droplet's, so this returns 502 even if a backend listens on the
    # host. To revive it, add the backend as a compose service and proxy to
    # http://<service>:<port> the way main-website does. The rewrite has to land
    # in the same change as the service: nginx fails config load with "host not
    # found in upstream" if the name does not resolve.
    location /php/ {
        proxy_pass http://127.0.0.1:8085/prod/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_redirect http://$host:8085/prod/ /php/;
        proxy_redirect /prod/ /php/;
    }
}
