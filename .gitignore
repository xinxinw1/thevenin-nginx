data/text-edit-data
data/mysql

# xin-xin.me's gitignored assets, mounted into main-website from the data
# directory because a build from a clone does not have them.
data/xin-xin-me

# Certbot key material. options-ssl-nginx.conf and ssl-dhparams.pem are public
# certbot defaults and stay committed so local dev works out of the box.
data/certbot/conf/live
data/certbot/conf/archive
data/certbot/conf/keys
data/certbot/conf/renewal
data/certbot/www

.env.secrets

# Ad-hoc environment files, e.g. a throwaway domain to test against.
.env.local

# The domain and data directory are inputs to this stack, not values it ships.
# On a droplet ~/setup.sh generates this file from the host type; see
# .env.example.
.env
