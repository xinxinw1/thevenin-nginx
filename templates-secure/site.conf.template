server {
    listen 443 ssl;
    server_name ${SITE_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${SITE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SITE_DOMAIN}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://main-website:8080/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    location /php/text-edit/ {
        proxy_pass http://text-edit/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_redirect http://text-edit/ /php/text-edit/;
        proxy_redirect / /php/text-edit/;
    }

    location /phpmyadmin/ {
        proxy_pass http://phpmyadmin/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # TODO: dead route. 127.0.0.1 here is this nginx container's own loopback,
    # not the droplet's, so this returns 502 even if a backend listens on the
    # host. To revive it, add the backend as a compose service and proxy to
    # http://<service>:<port> the way main-website does. The rewrite has to land
    # in the same change as the service: nginx fails config load with "host not
    # found in upstream" if the name does not resolve.
    location /code/hyphen/ {
        proxy_pass http://127.0.0.1:8088/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_redirect http://$host:8088/ /code/hyphen/;
        proxy_redirect / /code/hyphen/;
    }
}
