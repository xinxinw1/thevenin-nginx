server {
    listen 443 ssl;
    server_name ${SITE_DOMAIN} ${SITE_ALT_NAMES};

    ssl_certificate /etc/letsencrypt/live/${SITE_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SITE_CERT_NAME}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://main-website:8080/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    location /php/text-edit/ {
        proxy_pass http://text-edit/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_redirect http://text-edit/ /php/text-edit/;
        proxy_redirect / /php/text-edit/;
    }

    location /phpmyadmin/ {
        proxy_pass http://phpmyadmin/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # TODO: dead route. 127.0.0.1 here is this nginx container's own loopback,
    # not the droplet's, so this returns 502 even if a backend listens on the
    # host. To revive it, add the backend as a compose service and proxy to
    # http://<service>:<port> the way main-website does. The rewrite has to land
    # in the same change as the service: nginx fails config load with "host not
    # found in upstream" if the name does not resolve.
    location /code/hyphen/ {
        proxy_pass http://127.0.0.1:8088/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_redirect http://$host:8088/ /code/hyphen/;
        proxy_redirect / /code/hyphen/;
    }
}

# TODO: dead vhost. Every location below proxies to 127.0.0.1, which inside this
# container is the container itself, so the stage. subdomain serves nothing but
# 502s (templates-insecure still redirects it to https). Same fix as the routes
# above: bring the backends up as compose services and proxy to their service
# names.
server {
    listen 443 ssl;
    server_name stage.${SITE_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${SITE_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SITE_CERT_NAME}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:8083;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    location /php/ {
        proxy_pass http://127.0.0.1:8085/stage/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_redirect http://$host:8085/stage/ /php/;
    }

    location /r/ {
        proxy_pass http://127.0.0.1:8087/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_redirect http://$host:8087/ /r/;
    }
}
